    "content": "\\about\nSHOW DATABASES;\nCREATE DATABASE Movie_db; -- Creating Movie database\nUSE movie_db;-- Using movie database\n--## Creating Movie table\nCREATE TABLE Movie(\nMOV_ID INT NOT NULL PRIMARY KEY,\nTITLE VARCHAR(100),\nGenere VARCHAR(50),\nDirector VARCHAR(50),\nACTOR VARCHAR(50),\nACTRESS VARCHAR(50),\nRELEASE_YEAR INT,\nLANGUAGE VARCHAR(30),\nDURATION INT,\nRATING FLOAT,\nBUDGET BIGINT,\nCOLLECTION BIGINT\n);\n-- DESCRIBing Movie table schema\nDESC movie;\n-- ## Inserting data into TABLE\nINSERT INTO movie\nVALUES (1, 'Bahubali', 'Action', 'Rajamouli', 'Prabhas', 'Anushka', 2015, 'Telugu', 159, 8.5, \n1800000000, 6500000000), \n(2, 'RRR', 'Action', 'Rajamouli', 'Ram Charan', 'Alia', 2022, 'Telugu', 182, 9.0, \n5500000000, 12000000000), \n(3, 'Dangal', 'Sports', 'Nitesh Tiwari', 'Aamir Khan', 'Fatima', 2016, 'Hindi', 161, \n8.4, 700000000, 2000000000), \n(4, '3 Idiots', 'Drama', 'Rajkumar Hirani', 'Aamir Khan', 'Kareena', 2009, 'Hindi', \n170, 8.6, 550000000, 3900000000), \n(5, 'KGF 1', 'Action', 'Prashanth Neel', 'Yash', 'Srinidhi', 2018, 'Kannada', 156, 8.2, \n800000000, 2500000000), \n(6, 'KGF 2', 'Action', 'Prashanth Neel', 'Yash', 'Srinidhi', 2022, 'Kannada', 168, 8.8, \n1000000000, 12000000000), \n(7, 'Pushpa', 'Action', 'Sukumar', 'Allu Arjun', 'Rashmika', 2021, 'Telugu', 179, \n7.9, 1700000000, 3600000000), \n(8, 'Pathaan', 'Action', 'Siddharth Anand', 'SRK', 'Deepika', 2023, 'Hindi', 146, 7.5, \n2500000000, 10500000000), \n(9, 'Jawan', 'Action', 'Atlee', 'SRK', 'Nayanthara', 2023, 'Hindi', 169, 8.0, \n3000000000, 11500000000), \n(10, 'Titanic', 'Romance', 'James Cameron', 'Leonardo', 'Kate', 1997, 'English', \n195, 9.2, 2000000000, 18000000000), \n(11, 'Avatar', 'Sci-Fi', 'James Cameron', 'Sam Worthington', 'Zoe', 2009, 'English', \n162, 9.0, 2500000000, 29000000000), \n(12, 'Inception', 'Sci-Fi', 'Christopher Nolan', 'Leonardo', 'Ellen', 2010, 'English', \n148, 8.9, 1600000000, 8300000000), \n(13, 'Interstellar', 'Sci-Fi', 'Christopher Nolan', 'Matthew', 'Anne', 2014, 'English', \n169, 8.7, 1650000000, 7700000000), \n(14, 'Drishyam', 'Thriller', 'Jeethu Joseph', 'Ajay Devgn', 'Tabu', 2015, 'Hindi', \n163, 8.2, 380000000, 1000000000), \n(15, 'PK', 'Comedy', 'Rajkumar Hirani', 'Aamir Khan', 'Anushka', 2014, 'Hindi', \n153, 8.1, 850000000, 8500000000);\nSELECT*FROM movie;\nALTER TABLE movie -- Using Alter table to MODIFY table and ADD producer \nADD Producer VARCHAR(100);\nSELECT*FROM movie;\nSELECT*FROM movie WHERE LANGUAGE='Hindi';-- sorting Movie TABLE According to language hindi\nSELECT*FROM movie WHERE RATING=8.5;-- sorting table according to  rating\nUSE movie_db;\nSELECT Title,Collection FROM movie ORDER BY collection DESC -- it will sort the move in descending order \nLIMIT 5;-- the value of limit will show the how many VALUES we want to sort\nSELECT Title ,Release_year FROM movie WHERE RELEASE_YEAR>=2020;-- it will show the movie release after2020\nALTER TABLE movie RENAME COLUMN ACTOR TO LeadActor;-- RENAME column Actor to LeadActor\nDESC movie;\nALTER TABLE movie MODIFY RATING DOUBLE; -- Changing data type of movie float to Double\nDESC movie;\nCREATE INDEX idx_title ON movie(title);-- CREATE CACHE INDEX for fast searching \nCREATE VIEW TopMovies AS SELECT title, rating,collection FROM movie WHERE RATING>=8.5;\nDROP VIEW topmovies;\nDROP INDEX idx_title ON movie;\nSELECT*from movie;\n",
